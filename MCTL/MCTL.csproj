    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="Modrinth.Net" Version="3.8.2" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.2.0" />
  </ItemGroup>

</Project>
